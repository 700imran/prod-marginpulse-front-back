# ═══════════════════════════════════════════════════════════════════════════
#  MarginPulse Pro (Go) — .env.example
#  Copy to .env for local development (go run ./cmd/localserver).
#  In Lambda, these are set as function environment variables instead —
#  see infra/api-template.yaml and infra/worker-template.yaml.
# ═══════════════════════════════════════════════════════════════════════════

APP_ENV=development
APP_SECRET_KEY=change-me-openssl-rand-hex-32
APP_DEBUG=true
ALLOWED_ORIGINS=http://localhost:3000

# ── DynamoDB ──────────────────────────────────────────────────────────────
DYNAMODB_TABLE_NAME=marginpulse-development
DYNAMODB_ENDPOINT_URL=http://localhost:8000

# ── Redis (rate limiting, token blocklist, AI budget) ────────────────────
REDIS_URL=redis://localhost:6379/0

# ── AWS ───────────────────────────────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SQS_QUEUE_URL_OCR=
SQS_QUEUE_URL_RECONCILE=
SQS_QUEUE_URL_GST=
SQS_QUEUE_URL_TAX_IDENTIFIER=
SQS_QUEUE_URL_BANK_ACCOUNT=

# ── Storage (S3/R2 or local filesystem) ──────────────────────────────────
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/tmp/marginpulse-uploads
S3_BUCKET_NAME=marginpulse-documents
S3_REGION=auto
S3_ENDPOINT_URL=
MAX_UPLOAD_SIZE_MB=25

# ── WhatsApp ingest ───────────────────────────────────────────────────────
WHATSAPP_VERIFY_TOKEN=dev-verify-token
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v19.0

# ── Email ingest ──────────────────────────────────────────────────────────
WEBHOOK_INGEST_SECRET=
INGEST_EMAIL_ADDRESS=docs@marginpulse.io
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ── Anthropic (dashboard AI insights) ────────────────────────────────────
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-20250514
LLM_MAX_TOKENS=1024

# ── GST portal ────────────────────────────────────────────────────────────
GST_API_BASE_URL=https://api.gst.gov.in/commonapi
GST_API_CLIENT_ID=
GST_API_CLIENT_SECRET=
GST_API_USERNAME=

# ── JWT ───────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Field encryption (bank account numbers) ──────────────────────────────
FIELD_ENCRYPTION_KEY=change-me-openssl-rand-hex-32

# ── OCR (RapidOCR Python Lambda, invoked via AWS Lambda Invoke) ──────────
# See ocr-service/ — a small separate Lambda running the real,
# maintained rapidocr-onnxruntime package. Replaces an earlier
# tesseract/poppler-utils os/exec approach that hit real dnf/al2023
# base-image install failures in practice.
OCR_LAMBDA_FUNCTION_NAME=marginpulse-ocr-service-production

# ── Reconciliation thresholds ────────────────────────────────────────────
RECONCILE_CONFIDENCE_THRESHOLD=0.85
RECONCILE_AUTO_APPROVE_THRESHOLD=0.90

# ── Monitoring ────────────────────────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=INFO

# ── AI budget guard ───────────────────────────────────────────────────────
AI_MAX_PROMPT_TOKENS=8000
AI_MAX_COMPLETION_TOKENS=2000
AI_REQUESTS_PER_MINUTE_PER_TENANT=20
AI_DAILY_TOKEN_BUDGET_PER_TENANT=200000

# ── Secret rotation (informational) ──────────────────────────────────────
SECRET_ROTATION_DAYS=90

# ── OAuth login: Google ───────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
# (OAuth Client ID, type "Web application"). Add GOOGLE_REDIRECT_URI to
# that client's "Authorized redirect URIs" list — it must match exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# ── OAuth login: Apple (Sign in with Apple) ──────────────────────────────
# Requires an active Apple Developer Program membership. Create a
# Services ID (this is APPLE_CLIENT_ID) at
# https://developer.apple.com/account/resources/identifiers/list/serviceId,
# then a Sign in with Apple private key (.p8 file — its contents go in
# APPLE_PRIVATE_KEY, keep the BEGIN/END PRIVATE KEY lines).
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/apple/callback

# Where to send the browser after a successful OAuth login/connect —
# your deployed frontend's URL (Vercel).
FRONTEND_BASE_URL=http://localhost:3000

# ── Slack (push reconciliation alerts to a channel) ──────────────────────
# Create an app at https://api.slack.com/apps with the
# "incoming-webhook" OAuth scope.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:8000/api/v1/integrations/slack/callback

# ── Payment gateway integrations (Razorpay, Stripe) ──────────────────────
# No env vars needed here — tenants paste their own API keys through the
# app's Integrations page (POST /api/v1/integrations/{provider}/connect),
# encrypted at rest per-tenant, not configured globally.
