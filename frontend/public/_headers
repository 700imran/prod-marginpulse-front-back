/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://checkout.razorpay.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.razorpay.com; font-src 'self' data:; connect-src 'self' https://api.marginpulse.in https://prod-marginpulse-front-back.imrankhan210r.workers.dev https://*.supabase.co https://*.razorpay.com https://challenges.cloudflare.com; frame-src https://api.razorpay.com https://checkout.razorpay.com https://challenges.cloudflare.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), usb=(), payment=(self "https://checkout.razorpay.com" "https://api.razorpay.com")
  Cross-Origin-Opener-Policy: same-origin-allow-popups

# Build output under /static/ has a content hash in its file name (main.3f9a1c.js), so a given URL never changes:
# let browsers and the CDN keep it for a year without re-asking. index.html (and the unhashed OCR assets) stay on the
# default "revalidate with ETag" so a new deploy is picked up immediately.
/static/*
  Cache-Control: public, max-age=31536000, immutable
