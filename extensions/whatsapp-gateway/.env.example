# Where the Worker receives inbound files (must be https in production)
WORKER_WEBHOOK_URL=https://api.marginpulse.in/webhook/whatsapp-gateway
# Same value as `wrangler secret put WA_GATEWAY_WEBHOOK_SECRET` — signs every message sent to the Worker
WA_GATEWAY_WEBHOOK_SECRET=change-me-long-random
# Bearer token for this sidecar's /metrics, /qr, /qr.svg, /ready, /send (Worker secret WA_GATEWAY_TOKEN, Prometheus bearer)
WA_GATEWAY_TOKEN=change-me-another-long-random
# Persistent state (mount a volume here!). Losing AUTH_DIR means re-scanning the QR.
AUTH_DIR=/data/auth
SPOOL_DIR=/data/spool
PORT=8787
LOG_LEVEL=warn
