# backend-cloudflare/.env.example
#
# This is a REFERENCE, not a file Wrangler reads. Cloudflare Workers get
# their configuration two different ways, and this lists every value
# src/config.ts's Env interface expects, grouped by which one applies:
#
#   1. Bindings (R2 bucket, Hyperdrive, Queues) — declared in
#      wrangler.toml, not here. There's no env var for these; see that
#      file's [[r2_buckets]] / [[hyperdrive]] / [[queues.producers]].
#   2. Plain vars — go in wrangler.toml's [vars] section, in plain text.
#      Fine to commit; nothing below this line is a secret.
#   3. Secrets — NEVER go in wrangler.toml or any file that gets
#      committed. Set each one with:
#        wrangler secret put SECRET_NAME
#      which prompts for the value and stores it encrypted, separately
#      per environment (dev/staging/production — see NEXT_STEPS.md's
#      Phase A/B for the deploy-time setup order).
#
# Copy the shape below into a real .env only for local `wrangler dev`
# testing (wrangler dev reads .env automatically) — never commit that
# file. This one, with no real values in it, is what's committed.

# --- Plain vars (wrangler.toml [vars]) --------------------------------------

ENVIRONMENT=development
SUPABASE_URL=https://your-project-ref.supabase.co
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
GST_API_BASE_URL=https://api.gst-provider.example.com
ANTHROPIC_API_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-20250514
LLM_MAX_TOKENS=1024
AI_MAX_PROMPT_TOKENS=8000
AI_MAX_COMPLETION_TOKENS=2000
FRONTEND_ORIGIN=http://localhost:5173
INGEST_EMAIL_ADDRESS=documents@yourdomain.example.com
AI_INSIGHTS_DAILY_BUDGET_USD=5.00

# --- Secrets (`wrangler secret put <NAME>` — do not put real values here) --

# Settings > API > JWT Secret in your Supabase project
SUPABASE_JWT_SECRET=
# Settings > API > service_role key. Used only for the Supabase Admin API
# (src/auth/supabase.ts's deleteSupabaseAuthUser, called from
# src/purge.ts) — nothing else in this codebase touches it.
SUPABASE_SERVICE_ROLE_KEY=
# 32 random bytes, base64-encoded — e.g. `openssl rand -base64 32`.
# AES-256-GCM key for src/security/fieldEncryption.ts.
FIELD_ENCRYPTION_KEY=
UPSTASH_REDIS_REST_TOKEN=
ANTHROPIC_API_KEY=
# Leave these three GST_API_* blank to run with the graceful PENDING
# fallback (src/pipelines/gstsync.ts) until you have a real GST API
# contract — the adapter is fully implemented either way.
GST_API_CLIENT_ID=
GST_API_CLIENT_SECRET=
GST_API_USERNAME=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
RESEND_API_KEY=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
# Meta App Secret — verifies X-Hub-Signature-256 on inbound WhatsApp
# webhooks (routes/webhooks.ts). Leave blank only for local testing:
# production with this unset logs every inbound message as unverified.
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v19.0
# Shared secret your email-ingest provider sends back as
# X-Webhook-Secret — generate with e.g. `openssl rand -hex 32`.
WEBHOOK_INGEST_SECRET=
# Optional. Leave blank to disable Sentry entirely — structured console
# logging (Workers Logs) still works with no Sentry at all. See
# MONITORING.md before relying on this; it's not independently verified
# against a live Sentry project.
SENTRY_DSN=
